{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "executablePath": "/usr/bin/chromium",
      "chromiumSandbox": false
    },
    "contextOptions": {
      "serviceWorkers": "block"
    }
  },
  "network": {
    "allowedOrigins": ["http://localhost:3000"]
  },
  "capabilities": [
    "core",
    "core-navigation",
    "core-tabs",
    "core-input",
    "network"
  ],
  "outputDir": ".playwright-mcp"
}
