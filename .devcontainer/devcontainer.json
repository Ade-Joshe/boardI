{
  "name": "boardI",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // Fixed path so the image can pre-create node_modules (see Dockerfile).
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  "mounts": [
    // Per-container volume: dependency code never lands on the host.
    "source=boardi-node_modules-${devcontainerId},target=/workspace/node_modules,type=volume",
    // Skills are instructions the agent follows: treat as code, mount read-only.
    "source=${localEnv:HOME}/skills,target=/home/node/.agents/skills,type=bind,readonly"
  ],

  // Unprivileged user, no capabilities, no privilege escalation.
  // Malicious packages installed here can't reach host secrets.
  "containerUser": "node",
  "remoteUser": "node",
  "init": true,
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true"
  ],

  // Hide the host's SSH agent and git credentials from code in here.
  // Partial fix: sockets stay in /tmp, so also apply the README settings.
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": ""
  },

  // VS Code forwards ports on 127.0.0.1 only.
  // Don't add "appPort" or "-p": those expose the port on 0.0.0.0.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "mkdir -p ~/.claude/skills && for d in ~/.agents/skills/*/; do [ -d \"$d\" ] && ln -sfn \"$d\" ~/.claude/skills/\"$(basename \"$d\")\"; done; true",
  "postAttachCommand": "bash .devcontainer/check-isolation.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "npm.packageManager": "pnpm",
        "eslint.useFlatConfig": true
      }
    }
  }
}
