{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./package.json)",
      "Edit(./src/proxy.ts)",
      "Edit(./next.config.ts)",
      "Edit(./src/lib/env.ts)",
      "Edit(./eslint.config.mjs)",
      "Edit(./tests/**)",
      "Edit(./Dockerfile)",
      "Edit(./.devcontainer/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)"
    ]
  }
}
